<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="OriginsLauncher.exe"
             product-name="Origins Conquer Launcher"
             product-version="${version}"
             file-version="${version}.0"
             company-name="Origins Conquer"
             original-filename="OriginsLauncher.exe">
      <authenticode-sign hash-algorithm="sha256"
                         description="Origins Conquer Launcher"
                         description-url="https://github.com/paulobueno164/origins-launcher" />
    </pe-file>
  </zip-file>
</artifact-configuration>
