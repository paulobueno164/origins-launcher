<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ships with Windows 10/11, so players install nothing extra and the
       launcher stays a single small exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OriginsLauncher</AssemblyName>
    <RootNamespace>OriginsLauncher</RootNamespace>
    <Version>1.2.2</Version>
    <Company>Origins Conquer</Company>
    <Product>Origins Conquer Launcher</Product>
    <Description>Launcher e atualizador do Origins Conquer</Description>
    <Copyright>Origins Conquer</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="logo.ico" LogicalName="OriginsLauncher.logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
